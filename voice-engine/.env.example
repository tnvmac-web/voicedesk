# VoiceDesk environment configuration
# Copy to .env and fill in. Everything is optional in dev mode:
# without provider keys the voice engine runs in MOCK mode.

# --- App ---
APP_NAME=VoiceDesk
ENV=dev
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- Database ---
# dev default is a local SQLite file; set a Postgres URL in production
DATABASE_URL=sqlite:///./voicedesk.db

# --- Telephony (bring your own) ---
# provider: twilio | vonage | telnyx | mock
TELEPHONY_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_APPLICATION_ID=
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=

# --- Speech to text ---
# provider: deepgram | whisper | mock
STT_PROVIDER=mock
DEEPGRAM_API_KEY=

# --- LLM ---
# provider: openai | anthropic | ollama | mock
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=gpt-4o-mini

# --- Text to speech ---
# provider: elevenlabs | openai | piper | mock
TTS_PROVIDER=mock
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- WhatsApp Cloud API ---
WHATSAPP_VERIFY_TOKEN=voicedesk-verify
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Booking ---
# provider: google | caldav | internal | mock
CALENDAR_PROVIDER=internal
GOOGLE_CALENDAR_CREDENTIALS_JSON=

# --- Billing / metering ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
